FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      EPotential;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 1e-10;

boundaryField
{
    ground
    {
        type        plasmaPower;
	    power		0.098;
	    nCycles		1;
	    dampingFactor	0.01;
	    value		uniform 1e-10;
	    model		sinFrequencyModulated;
	    amplitude	100;
	    frequency	80E9;
	    bias		0;
    }
    electrode
    {
        type            fixedValue;
	    value 		uniform 1e-10;
    }

}
